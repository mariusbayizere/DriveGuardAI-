package com.example.DriveGuardAI.controller;

import java.util.List;
import java.util.Optional;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.security.authentication.BadCredentialsException;
import org.springframework.security.authentication.UsernamePasswordAuthenticationToken;
import org.springframework.security.core.Authentication;
import org.springframework.security.core.GrantedAuthority;
import org.springframework.security.core.authority.AuthorityUtils;
import org.springframework.security.core.context.SecurityContextHolder;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.example.DriveGuardAI.model.EmailDetails;
import com.example.DriveGuardAI.model.Users;
import com.example.DriveGuardAI.repository.UserRepository;
import com.example.DriveGuardAI.SecurityConfig.JwtProvider;
import com.example.DriveGuardAI.response.AuthResponse;
import com.example.DriveGuardAI.service.EmailService;

import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.responses.ApiResponse;
import io.swagger.v3.oas.annotations.responses.ApiResponses;
import io.swagger.v3.oas.annotations.tags.Tag;


import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestHeader;
import java.util.HashMap;
import java.util.Map;


@RestController
@RequestMapping("/api/v1/auth")
@Tag(name = "User Authentication", description = "APIs for user authentication and registration")
public class UserAutho {

    @Autowired
    private UserRepository userRepository;

    @Autowired
    private PasswordEncoder passwordEncoder;

    @Autowired
    private EmailService emailService;

    @Operation(summary = "Register a new user", description = "Allows a new user to register in the system")
    @ApiResponses(value = {
        @ApiResponse(responseCode = "200", description = "User registered successfully"),
        @ApiResponse(responseCode = "400", description = "Email already exists or passwords do not match")
    })
    @PostMapping("/signup")
    public ResponseEntity<AuthResponse> createUserHandler(@RequestBody Users user) {
        String email = user.getEmail();

        // Check if email already exists
        Optional<Users> isEmailExist = userRepository.findByEmail(email);
        if (isEmailExist.isPresent()) {
            return ResponseEntity.status(HttpStatus.BAD_REQUEST)
                    .body(new AuthResponse(false, "Email is already used", null));
        }

        // Validate that password and confirmPassword match (plain text comparison before encoding)
        if (user.getPassword() == null || user.getConfirmPassword() == null) {
            return ResponseEntity.status(HttpStatus.BAD_REQUEST)
                    .body(new AuthResponse(false, "Password and Confirm Password are required", null));
        }

        if (!user.getPassword().equals(user.getConfirmPassword())) {
            return ResponseEntity.status(HttpStatus.BAD_REQUEST)
                    .body(new AuthResponse(false, "Passwords do not match", null));
        }

        // Save raw password before encoding (needed for authentication token)
        String rawPassword = user.getPassword();

        // Encode and set the password
        String encodedPassword = passwordEncoder.encode(rawPassword);
        user.setPassword(encodedPassword);
        user.setConfirmPassword(null); // Clear confirm password — not stored in DB

        // Save user to database
        userRepository.save(user);

        // Build authentication using raw password
        Authentication authentication = new UsernamePasswordAuthenticationToken(email, rawPassword);
        SecurityContextHolder.getContext().setAuthentication(authentication);
        String token = JwtProvider.generateToken(authentication);

        // Send registration confirmation email
        EmailDetails emailDetails = new EmailDetails();
        emailDetails.setRecipient(email);
        emailDetails.setSubject("Registration Successful");
        emailDetails.setMsgBody("Hello " + user.getFirstName() + ",\n\nYou have successfully registered to DriveGuardAI.");
        emailService.sendSimpleMail(emailDetails);

        return ResponseEntity.ok(new AuthResponse(true, "Register Success", token));
    }

    @Operation(summary = "User Sign-in", description = "Authenticates a user and returns a JWT token")
    @ApiResponses(value = {
        @ApiResponse(responseCode = "200", description = "Signin successful"),
        @ApiResponse(responseCode = "400", description = "Invalid username or password")
    })
    @PostMapping("/signin")
    public ResponseEntity<AuthResponse> signin(@RequestBody Users loginRequest) {
        String username = loginRequest.getEmail();
        String password = loginRequest.getPassword();

        // Validate input
        if (username == null || password == null) {
            return ResponseEntity.status(HttpStatus.BAD_REQUEST)
                    .body(new AuthResponse(false, "Email and password are required", null));
        }

        try {
            Authentication authentication = authenticate(username, password);
            SecurityContextHolder.getContext().setAuthentication(authentication);
            String token = JwtProvider.generateToken(authentication);
            return ResponseEntity.ok(new AuthResponse(true, "Signin Success", token));
        } catch (BadCredentialsException e) {
            return ResponseEntity.status(HttpStatus.UNAUTHORIZED)
                    .body(new AuthResponse(false, "Invalid username or password", null));
        }
    }

    /**
     * Authenticates a user by verifying their email exists in the database
     * and that the provided raw password matches the stored BCrypt hash.
     */
    private Authentication authenticate(String username, String password) {
        Optional<Users> optionalUser = userRepository.findByEmail(username);

        if (!optionalUser.isPresent()) {
            throw new BadCredentialsException("Invalid username or password");
        }

        Users foundUser = optionalUser.get();

        // ✅ Verify raw password against the stored BCrypt hash
        if (!passwordEncoder.matches(password, foundUser.getPassword())) {
            throw new BadCredentialsException("Invalid username or password");
        }

        List<GrantedAuthority> authorities = AuthorityUtils.createAuthorityList(foundUser.getUserRole().name());
        return new UsernamePasswordAuthenticationToken(username, password, authorities);
    }





//-----------------

     /**
     * GET /api/v1/auth/me
     *
     * Decodes the JWT from the Authorization header and returns the
     * current user's profile including their real database ID.
     *
     * This solves the React frontend issue where API calls were being
     * made to /api/drivers/user/undefined because the user ID was not
     * yet resolved. The frontend should call /me first after login,
     * then use the returned ID for all subsequent requests.
     *
     * Header required: Authorization: Bearer <token>
     */
    @Operation(summary = "Get current logged-in user", description = "Returns user profile decoded from JWT token")
    @ApiResponses(value = {
        @ApiResponse(responseCode = "200", description = "User profile returned"),
        @ApiResponse(responseCode = "401", description = "Invalid or expired token"),
        @ApiResponse(responseCode = "404", description = "User not found")
    })
    @GetMapping("/me")
    public ResponseEntity<?> getCurrentUser(@RequestHeader("Authorization") String authHeader) {
        try {
            // ✅ FIXED: was getEmailFromToken() — correct name is getEmailFromJwtToken()
            // getEmailFromJwtToken() expects the full "Bearer xxx" string
            // and strips the prefix internally with substring(7)
            String email = JwtProvider.getEmailFromJwtToken(authHeader);

            Optional<Users> optionalUser = userRepository.findByEmail(email);
            if (!optionalUser.isPresent()) {
                return ResponseEntity.status(HttpStatus.NOT_FOUND)
                        .body(new AuthResponse(false, "User not found", null));
            }

            Users foundUser = optionalUser.get();

            // Return safe user fields including the real DB id
            Map<String, Object> userMap = new HashMap<>();
            userMap.put("id",          foundUser.getId());
            userMap.put("email",       foundUser.getEmail());
            userMap.put("firstName",   foundUser.getFirstName());
            userMap.put("lastName",    foundUser.getLastName());
            userMap.put("phoneNumber", foundUser.getPhoneNumber());
            userMap.put("role",        foundUser.getUserRole());

            return ResponseEntity.ok(userMap);

        } catch (Exception e) {
            return ResponseEntity.status(HttpStatus.UNAUTHORIZED)
                    .body(new AuthResponse(false, "Invalid or expired token", null));
        }
    }

  }
