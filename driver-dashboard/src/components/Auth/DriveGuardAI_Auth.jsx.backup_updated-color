            </div>
            <button className="dg-ov-btn" onClick={() => switchMode(!isLogin)}>
              {isLogin ? "CREATE ACCOUNT" : "SIGN IN"}
            </button>
          </div>
        </div>

        {/* ── Sign Up Form ── */}
        <div className="dg-form-panel">
          <div className="dg-logo-box">
            <svg viewBox="0 0 24 24" fill="white" style={{ width: 20, height: 20 }}><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
          </div>
          <div className="dg-title">Create Account</div>
          <div className="dg-sub">Join DriveGuard AI — drive smarter &amp; safer</div>

          {!isLogin && message && (
            <div className={`dg-msg ${message.type === "success" ? "dg-ok" : "dg-err"}`}>
              {message.text}
            </div>
          )}

          <div className="dg-irow">
            <div className="dg-igroup">
              <label className="dg-label">First Name</label>
              <input className="dg-input" name="firstName" placeholder="Aime" value={form.firstName} onChange={handle}/>
            </div>
            <div className="dg-igroup">
              <label className="dg-label">Last Name</label>
              <input className="dg-input" name="lastName" placeholder="Roger" value={form.lastName} onChange={handle}/>
            </div>
          </div>

          <div className="dg-igroup">
            <label className="dg-label">Email Address</label>
            <input className="dg-input" name="email" type="email" placeholder="driver@company.com" value={form.email} onChange={handle}/>
          </div>

          <div className="dg-igroup">
            <label className="dg-label">Phone Number</label>
            <PhoneInput value={form.phone} onChange={(e) => setForm(f => ({ ...f, phone: e.target.value }))}/>
            {form.phone && (
              <div style={{ fontSize: 11, color: '#6b7280', marginTop: 4, paddingLeft: 2 }}>
                Will be saved as: <strong style={{ color: '#1d9460' }}>{form.phone}</strong>
              </div>
            )}
          </div>

          <div className="dg-igroup">
            <label className="dg-label">Role</label>
            <select className="dg-select" name="role" value={form.role} onChange={handle}>
              <option value="DRIVER">Driver</option>
              <option value="MANAGER">Manager</option>
              <option value="ADMIN">Admin</option>
            </select>
          </div>

          <div className="dg-igroup">
            <label className="dg-label">Password</label>
            <div style={{ position: "relative" }}>
              <input className="dg-input" name="password" type={showPass ? "text" : "password"} placeholder="Min. 8 characters" value={form.password} onChange={handle} style={{ paddingRight: 44 }}/>
              <button className="dg-eye" onClick={() => setShowPass(!showPass)}><EyeIcon open={showPass}/></button>
            </div>
          </div>

          <div className="dg-igroup">
            <label className="dg-label">Confirm Password</label>
            <div style={{ position: "relative" }}>
              <input className="dg-input" name="confirmPassword" type={showConfirm ? "text" : "password"} placeholder="Repeat password" value={form.confirmPassword} onChange={handle} style={{ paddingRight: 44 }}/>
              <button className="dg-eye" onClick={() => setShowConfirm(!showConfirm)}><EyeIcon open={showConfirm}/></button>
            </div>
          </div>

          <button className="dg-submit" onClick={!isLogin ? submit : undefined} disabled={loading}>
            {loading && !isLogin ? <><div className="dg-spinner"/><span>Creating account...</span></> : <span>→  CREATE ACCOUNT</span>}
          </button>

          {/* ── Google Button (Sign Up) ── */}
          <div className="dg-divider">
            <div className="dg-divider-line"/>
            <span className="dg-divider-txt">OR</span>
            <div className="dg-divider-line"/>
          </div>
          <GoogleButton />

          <p style={{ fontSize: 13, color: "#6b7280", textAlign: "center", marginTop: 12 }}>
            Already have an account?{" "}<button className="dg-link-btn" onClick={() => switchMode(true)}>Sign in →</button>
          </p>
        </div>

      </div>
    </div>
  );
}
