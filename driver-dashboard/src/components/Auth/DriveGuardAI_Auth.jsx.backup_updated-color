// ─────────────────────────────────────────────────────────────────────────
export default function DriveGuardAuth({ onAuthSuccess }) {
  const [isLogin, setIsLogin] = useState(true);
  const [showPass, setShowPass] = useState(false);
  const [showConfirm, setShowConfirm] = useState(false);
  const [loading, setLoading] = useState(false);
  const [message, setMessage] = useState(null);
  const [form, setForm] = useState({
    firstName: "", lastName: "", email: "",
    phone: "", role: "DRIVER", password: "", confirmPassword: ""
  });

  const handle = (e) => setForm(f => ({ ...f, [e.target.name]: e.target.value }));

  const submit = async () => {
    if (!form.email || !form.password) {
      setMessage({ type: "error", text: "Please fill in all required fields." });
      return;
    }
    if (!isLogin && form.password !== form.confirmPassword) {
      setMessage({ type: "error", text: "Passwords do not match." });
      return;
    }

    setLoading(true);
    setMessage(null);

    try {
      const url = isLogin
        ? 'http://localhost:8080/api/v1/auth/signin'
        : 'http://localhost:8080/api/v1/auth/signup';

      const body = isLogin
        ? { email: form.email, password: form.password }
        : {
            firstName:       form.firstName,
            lastName:        form.lastName,
            email:           form.email,
            phoneNumber:     form.phone,
            userRole:        form.role,
            password:        form.password,
            confirmPassword: form.confirmPassword
          };

      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });

      const data = await res.json();

      if (data.status === true) {
        setLoading(false);
        setMessage({
          type: "success",
          text: isLogin
            ? "✓ Sign in successful! Redirecting to dashboard..."
            : "✓ Account created! Welcome to DriveGuard AI."
        });
        setTimeout(() => {
          if (onAuthSuccess) {
            onAuthSuccess(data.jwt, { email: form.email, role: data.role, ...form });
          }
        }, 800);
      } else {
        setLoading(false);
        setMessage({ type: "error", text: data.message || "Something went wrong." });
      }

    } catch (err) {
      setLoading(false);
      setMessage({ type: "error", text: "Cannot connect to server. Make sure Spring Boot is running on port 8080." });
    }
  };

  const switchMode = (toLogin) => {
    setIsLogin(toLogin);
    setMessage(null);
    setForm({ firstName: "", lastName: "", email: "", phone: "", role: "DRIVER", password: "", confirmPassword: "" });
  };

  const css = `
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    .dg-wrap { min-height:100vh; display:flex; align-items:center; justify-content:center; background:radial-gradient(ellipse at 20% 50%,#e8f5f0 0%,#f0f9f5 60%,#ffffff 100%); padding:20px; }
    .dg-card { position:relative; width:880px; min-height:600px; border-radius:28px; display:flex; overflow:hidden; box-shadow:0 50px 120px rgba(0,0,0,0.12),0 0 0 1px rgba(0,0,0,0.06); }
    .dg-form-panel { flex:0 0 50%; background:#ffffff; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:40px 48px; overflow-y:auto; }
    .dg-overlay { position:absolute; top:0; width:50%; height:100%; background:linear-gradient(150deg,#0b6e44 0%,#1d9460 35%,#147a4f 65%,#084d30 100%); display:flex; flex-direction:column; align-items:center; justify-content:center; padding:50px 40px; z-index:20; overflow:hidden; transition:transform 0.75s cubic-bezier(0.76,0,0.24,1); }
    .dg-overlay.left  { left:0; transform:translateX(0); }
    .dg-overlay.right { left:0; transform:translateX(100%); }
    .dg-blob1 { position:absolute; width:320px; height:320px; border-radius:50%; background:rgba(255,255,255,0.03); top:-80px; left:-80px; }
    .dg-blob2 { position:absolute; width:200px; height:200px; border-radius:50%; background:rgba(255,255,255,0.04); bottom:-50px; right:-50px; }
    .dg-ring  { position:absolute; width:400px; height:400px; border-radius:50%; border:1px solid rgba(255,255,255,0.06); top:-120px; left:-120px; }
    .dg-badge { background:rgba(255,255,255,0.15); border:1px solid rgba(255,255,255,0.25); border-radius:50px; padding:6px 20px; font-size:10px; font-weight:700; color:white; letter-spacing:2.5px; text-transform:uppercase; margin-bottom:20px; }
    .dg-ov-title { font-family:'Plus Jakarta Sans',sans-serif; font-size:30px; font-weight:800; color:white; text-align:center; line-height:1.25; margin-bottom:12px; }
