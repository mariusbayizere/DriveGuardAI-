            <div style={{ marginTop: 12 }}>
              {["Real-time AI Detection", "Instant Driver Alerts", "Fleet Safety Reports"].map(f => (
                <div className="dg-feat" key={f}><div className="dg-feat-dot"/><span className="dg-feat-text">{f}</span></div>
