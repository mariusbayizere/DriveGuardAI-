    .dg-submit:hover:not(:disabled) { transform:translateY(-2px); box-shadow:0 8px 28px rgba(29,148,96,0.45); }
    .dg-submit:disabled { opacity:0.65; cursor:not-allowed; transform:none; }
    .dg-divider { display:flex; align-items:center; gap:12px; margin:14px 0; width:100%; }
    .dg-divider-line { flex:1; height:1px; background:#e5e7eb; }
    .dg-divider-txt  { font-size:12px; color:#9ca3af; font-weight:600; }
    .dg-link-btn { background:none; border:none; color:#1d9460; font-weight:800; cursor:pointer; font-size:13px; font-family:'Plus Jakarta Sans',sans-serif; }
    .dg-msg { padding:10px 14px; border-radius:10px; font-size:13px; font-weight:600; margin-bottom:12px; width:100%; }
    .dg-ok  { background:#d1fae5; color:#064e3b; }
    .dg-err { background:#fee2e2; color:#991b1b; }
    .dg-spinner { width:18px; height:18px; border:2.5px solid rgba(255,255,255,0.3); border-top-color:white; border-radius:50%; animation:spin 0.7s linear infinite; }
    @keyframes spin { to { transform:rotate(360deg); } }
  `;

  return (
    <div className="dg-wrap">
      <style>{css}</style>
      <div className="dg-card">

        {/* ── Sign In Form ── */}
        <div className="dg-form-panel">
          <div className="dg-logo-box">
            <svg viewBox="0 0 24 24" fill="white" style={{ width: 20, height: 20 }}><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
          </div>
          <div className="dg-title">Welcome Back</div>
          <div className="dg-sub">Sign in to your DriveGuard AI account</div>

          {isLogin && message && (
            <div className={`dg-msg ${message.type === "success" ? "dg-ok" : "dg-err"}`}>
              {message.text}
            </div>
          )}

          <div className="dg-igroup">
            <label className="dg-label">Email Address</label>
            <input className="dg-input" name="email" type="email" placeholder="driver@company.com" value={form.email} onChange={handle}/>
          </div>
          <div className="dg-igroup">
            <label className="dg-label">Password</label>
            <div style={{ position: "relative" }}>
              <input className="dg-input" name="password" type={showPass ? "text" : "password"} placeholder="Enter your password" value={form.password} onChange={handle} style={{ paddingRight: 44 }}/>
              <button className="dg-eye" onClick={() => setShowPass(!showPass)}><EyeIcon open={showPass}/></button>
            </div>
          </div>

          <div style={{ width: "100%", textAlign: "right", marginTop: -6, marginBottom: 14 }}>
            <button onClick={() => {}} style={{ fontSize: 13, color: "#1d9460", fontWeight: 700, background: "none", border: "none", cursor: "pointer", fontFamily: "'Plus Jakarta Sans',sans-serif" }}>
              Forgot password?
            </button>
          </div>

          <button className="dg-submit" onClick={isLogin ? submit : undefined} disabled={loading}>
            {loading && isLogin ? <><div className="dg-spinner"/><span>Signing in...</span></> : <span>→  SIGN IN</span>}
