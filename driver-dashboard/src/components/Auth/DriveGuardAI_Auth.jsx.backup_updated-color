    .dg-ov-btn:hover { background:white; color:#0b6e44; }
    .dg-logo-box { width:40px; height:40px; background:linear-gradient(135deg,#1d9460,#0b6e44); border-radius:12px; display:flex; align-items:center; justify-content:center; margin-bottom:12px; box-shadow:0 4px 15px rgba(29,148,96,0.4); }
    .dg-title { font-family:'Plus Jakarta Sans',sans-serif; font-size:26px; font-weight:800; color:#0a1628; margin-bottom:4px; }
    .dg-sub   { font-size:13px; color:#6b7280; margin-bottom:22px; }
    .dg-label { display:block; font-size:11px; font-weight:700; color:#374151; letter-spacing:1px; text-transform:uppercase; margin-bottom:5px; }
    .dg-input { width:100%; padding:11px 16px; border:1.5px solid #e5e7eb; border-radius:12px; font-size:14px; font-family:'Plus Jakarta Sans',sans-serif; color:#111827; background:#fff; outline:none; transition:border-color 0.2s,box-shadow 0.2s; }
    .dg-input:focus { border-color:#1d9460; box-shadow:0 0 0 3px rgba(29,148,96,0.13); }
    .dg-select { width:100%; padding:11px 16px; border:1.5px solid #e5e7eb; border-radius:12px; font-size:14px; font-family:'Plus Jakarta Sans',sans-serif; color:#111827; background:#fff; outline:none; appearance:none; transition:border-color 0.2s; }
    .dg-select:focus { border-color:#1d9460; box-shadow:0 0 0 3px rgba(29,148,96,0.13); }
