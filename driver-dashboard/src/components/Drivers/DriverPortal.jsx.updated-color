  const col = p>=80?'#22c55e':p>=60?'#fbbf24':'#f87171';
  return (
    <svg width={130} height={130} style={{ display:'block', margin:'0 auto' }}>
      <circle cx={65} cy={65} r={r} fill="none" stroke={`${col}22`} strokeWidth={10}/>
