              <div style={{
                fontSize:11, color:'#9ca3af', marginTop:1,
                maxWidth:230, overflow:'hidden', textOverflow:'ellipsis', whiteSpace:'nowrap',
              }}>
                {current.filename}
              </div>
            </div>
          </div>
          <div style={{ display:'flex', alignItems:'center', gap:8 }}>
            {/* Violation type badge */}
            <span style={{
              fontSize:11, fontWeight:700,
              color: m.color, background: m.bg,
              padding:'4px 12px', borderRadius:20,
            }}>
              {m.label}
            </span>
            {/* Close button */}
            <button
              className="modal-nav-btn modal-close-btn"
              onClick={() => setModalShot(null)}
              style={{
                background:'#f9fafb',
                color:'#6b7280',
                border:'1px solid #e5e7eb',
              }}>
              <Icons.X/>
            </button>
          </div>
        </div>

        {/* ── Image area ── */}
        <div style={{
          background:'#0f172a',
          minHeight:300, maxHeight:380,
          display:'flex', alignItems:'center', justifyContent:'center',
          position:'relative', overflow:'hidden',
        }}>

          {/* Counter badge (top-right) */}
          {siblings.length > 1 && (
            <div style={{
              position:'absolute', top:12, right:12,
              fontSize:11, fontWeight:700,
              background:'rgba(0,0,0,.6)', color:'#fff',
              padding:'4px 10px', borderRadius:20, zIndex:4,
              backdropFilter:'blur(4px)',
            }}>
              {index + 1} / {siblings.length}
            </div>
          )}

          {/* Loading spinner */}
          {imgLoad && !imgErr && (
            <div style={{
              position:'absolute', inset:0,
              display:'flex', flexDirection:'column',
              alignItems:'center', justifyContent:'center', gap:12, zIndex:2,
            }}>
              <div style={{
                width:40, height:40,
                border:'3px solid rgba(255,255,255,.12)',
                borderTopColor:'#86efac',
                borderRadius:'50%',
                animation:'spin .7s linear infinite',
              }}/>
              <div style={{ fontSize:12, color:'rgba(255,255,255,.35)', fontWeight:500 }}>
                Loading screenshot…
              </div>
              <div style={{ fontSize:10, color:'rgba(255,255,255,.2)' }}>
                {current.url}
              </div>
            </div>
          )}

          {/* Error state */}
          {imgErr && (
            <div style={{
              display:'flex', flexDirection:'column',
              alignItems:'center', gap:12,
              color:'rgba(255,255,255,.35)',
              padding:40, textAlign:'center',
            }}>
              <div style={{ opacity:.4 }}><Icons.ImgBroken/></div>
              <div style={{ fontSize:13, fontWeight:600, color:'rgba(255,255,255,.5)' }}>
                Image not available
              </div>
              <div style={{ fontSize:11, color:'rgba(255,255,255,.25)', maxWidth:260 }}>
                Could not load: {current.url}
              </div>
              <div style={{ fontSize:11, color:'rgba(255,255,255,.25)' }}>
                Make sure Flask has the /api/screenshots/&lt;filename&gt; route and CORS is enabled.
              </div>
            </div>
          )}

          {/* The actual image */}
          {!imgErr && (
            <img
              key={current.url}
              src={current.url}
              alt={current.filename}
              crossOrigin="anonymous"
              onLoad={() => {
                console.log('DEBUG Modal: Image loaded OK:', current.url);
                setImgLoad(false);
              }}
              onError={(e) => {
                console.error('DEBUG Modal: Image FAILED to load:', current.url, e);
                setImgLoad(false);
                setImgErr(true);
              }}
              style={{
                maxWidth:'100%', maxHeight:380,
                objectFit:'contain',
                display: imgLoad ? 'none' : 'block',
                margin:'0 auto',
              }}
            />
          )}

          {/* ← Prev arrow (overlaid on image) */}
          {siblings.length > 1 && (
            <button
              className="modal-nav-btn"
              onClick={() => setModalShot(p => ({ ...p, index: p.index - 1 }))}
              disabled={!hasPrev}
              style={{
                position:'absolute', left:12, top:'50%', transform:'translateY(-50%)',
                background: hasPrev ? 'rgba(255,255,255,.92)' : 'rgba(255,255,255,.15)',
                color: hasPrev ? '#374151' : 'rgba(255,255,255,.25)',
                zIndex:5, border:'none',
              }}>
              <Icons.ChevLeft/>
            </button>
          )}

          {/* Next → arrow (overlaid on image) */}
          {siblings.length > 1 && (
            <button
              className="modal-nav-btn"
              onClick={() => setModalShot(p => ({ ...p, index: p.index + 1 }))}
              disabled={!hasNext}
              style={{
                position:'absolute', right:12, top:'50%', transform:'translateY(-50%)',
                background: hasNext ? 'rgba(255,255,255,.92)' : 'rgba(255,255,255,.15)',
                color: hasNext ? '#374151' : 'rgba(255,255,255,.25)',
                zIndex:5, border:'none',
              }}>
              <Icons.ChevRight/>
            </button>
          )}
        </div>

        {/* ── Footer ── */}
        <div style={{
          padding:'14px 20px',
          borderTop:'1px solid #f1f5f9',
          display:'flex', alignItems:'center', justifyContent:'space-between',
          background:'#fafafa',
        }}>
          <div>
            <div style={{ fontSize:12, color:'#6b7280' }}>
              Captured{' '}
              <span style={{ color:'#111827', fontWeight:700 }}>{formattedDate}</span>
            </div>
            {siblings.length > 1 && (
              <div style={{ fontSize:11, color:'#9ca3af', marginTop:2 }}>
                {siblings.length} screenshots for this violation
              </div>
            )}
          </div>

          <div style={{ display:'flex', gap:8, alignItems:'center' }}>
            {/* Prev / Next footer buttons (only if multiple) */}
            {siblings.length > 1 && (
              <>
                <button
                  className="modal-nav-btn"
                  onClick={() => setModalShot(p => ({ ...p, index: p.index - 1 }))}
                  disabled={!hasPrev}
                  style={{
                    width:34, height:34,
                    background: hasPrev ? '#fff' : '#f9fafb',
                    color: hasPrev ? '#374151' : '#d1d5db',
                    border:'1px solid #e5e7eb',
                  }}>
                  <Icons.ChevLeft/>
                </button>
                <button
                  className="modal-nav-btn"
                  onClick={() => setModalShot(p => ({ ...p, index: p.index + 1 }))}
                  disabled={!hasNext}
                  style={{
                    width:34, height:34,
                    background: hasNext ? '#fff' : '#f9fafb',
                    color: hasNext ? '#374151' : '#d1d5db',
                    border:'1px solid #e5e7eb',
                  }}>
                  <Icons.ChevRight/>
                </button>
              </>
            )}

            {/* Save / Download button */}
            <button
              onClick={handleDownload}
              style={{
                display:'inline-flex', alignItems:'center', gap:6,
                padding:'7px 16px', borderRadius:9,
                border:'1.5px solid #bbf7d0', background:'#f0fdf4', color:'#15803d',
                fontSize:12, fontWeight:700, cursor:'pointer',
                fontFamily:"'Plus Jakarta Sans',sans-serif",
                transition:'all .15s ease',
              }}>
              <Icons.Download/> Save
            </button>
          </div>
        </div>
      </div>
    </div>
  );
};

// ══════════════════════════════════════════════════════════════════════════
//  MAIN PORTAL
// ══════════════════════════════════════════════════════════════════════════
export default function DriverPortal() {
  const [user]  = useState(()=>getUser());
  const [token] = useState(()=>getToken());
  const [tab,           setTab]           = useState('dashboard');
  const [incidents,     setIncidents]     = useState([]);
  const [trips,         setTrips]         = useState([]);
  const [vehicles,      setVehicles]      = useState({});
  const [driverInfo,    setDriverInfo]    = useState(null);
  const [fullUserInfo,  setFullUserInfo]  = useState(null);
  const [loading,       setLoading]       = useState(true);
  const [error,         setError]         = useState(null);
  const [noProfile,     setNoProfile]     = useState(false);
  const [sideCollapsed, setSideCollapsed] = useState(false);
  const [resolvedId,    setResolvedId]    = useState(null);
  const [screenshots,   setScreenshots]   = useState([]);
  const [modalShot,     setModalShot]     = useState(null);

  const authH = useCallback(()=>({ 'Content-Type':'application/json','Authorization':`Bearer ${token}` }),[token]);

  // ── Fetch screenshots list from Flask ─────────────────────────────────
  // FIX 1: Parse data.screenshots (object), not data (array)
  useEffect(() => {
    const url = `${FLASK_BASE}/api/screenshots`;
    console.log('DEBUG screenshots: Fetching list from', url);

    fetch(url)
      .then(r => {
        console.log('DEBUG screenshots: Response status:', r.status);
        if (!r.ok) throw new Error('Status ' + r.status);
        return r.json();
      })
      .then(data => {
        console.log('DEBUG screenshots: Raw response:', data);

        // Flask returns: { total: N, screenshots: ["file1.jpg", ...], path: "..." }
        const rawList = data?.screenshots ?? (Array.isArray(data) ? data : []);
        console.log('DEBUG screenshots: Raw list:', rawList.slice(0,5));

        const list = rawList
          .map(item => {
            // item is a plain filename string like "distracted_20260413_072649.jpg"
            if (typeof item === 'string') {
              const filename = item.split('/').pop();
              // FIX 2: This URL requires the serve_screenshot Flask route to exist
              return {
                filename,
                url: `${FLASK_BASE}/api/screenshots/${encodeURIComponent(filename)}`,
              };
            }
            // or it might be an object
            const filename = item.filename ?? item.name ?? '';
            return {
              filename,
              url: `${FLASK_BASE}/api/screenshots/${encodeURIComponent(filename)}`,
            };
          })
          .filter(s => s.filename);

        console.log('DEBUG screenshots: Processed list (' + list.length + ' items):', list.slice(0,3));
        setScreenshots(list);
      })
      .catch(err => {
        console.error('DEBUG screenshots: Fetch error:', err);
        setScreenshots([]);
      });
  }, []);

  // ── Parse screenshot filename → { type, ts } ─────────────────────────
  const parseScreenshotFilename = useCallback((filename) => {
    // Matches: distracted_20260413_072649.jpg
    //          eyes_closed_20260411_121926.jpg
    //          no_seatbelt_20260412_135517.jpg
    //          phone_use_20260413_072200.jpg
    const m = filename.match(/^(.+?)_(\d{8})_(\d{6})/);
    if (!m) return null;
    const [, rawType, d, t] = m;
    const ts = new Date(
      `${d.slice(0,4)}-${d.slice(4,6)}-${d.slice(6,8)}T${t.slice(0,2)}:${t.slice(2,4)}:${t.slice(4,6)}`
    );
    return { type: rawType.toUpperCase().replace(/-/g,'_'), ts };
  }, []);

  // ── Normalize type for matching ───────────────────────────────────────
  const normalizeTypeForMatch = useCallback((typeStr) => {
    const t = typeStr.toUpperCase().replace(/-/g,'_').replace(/\s/g,'_');
    if (t.includes('PHONE'))                               return 'PHONE_USE';
    if (t.includes('EYES_CLOSED') || t.includes('EYE'))   return 'DROWSY';
    if (t.includes('DROWS') || t.includes('SLEEP') || t.includes('FATIGUE')) return 'DROWSY';
    if (t.includes('SEATBELT') || t.includes('SEAT'))     return 'NO_SEATBELT';
    if (t.includes('DISTRACT'))                            return 'DISTRACTED';
    if (t.includes('SMOKING'))                             return 'SMOKING';
    if (t.includes('DRUNK'))                               return 'DRUNK_DRIVING';
    return t;
  }, []);

  // ── Find screenshots that match a violation ───────────────────────────
  const findMatchingShots = useCallback((inc) => {
    if (!screenshots.length) return [];

    const incType          = resolveIncidentType(inc);
    const normalizedIncType = normalizeTypeForMatch(incType);

    console.log('DEBUG findMatchingShots: incType=', incType, '→ normalized=', normalizedIncType);

    const rawTime = inc?.timestamp ?? inc?.detectedAt ?? inc?.createdAt ?? null;
    const vTime   = rawTime ? new Date(rawTime) : null;

    const parsed = screenshots
      .map(s => ({ ...s, parsed: parseScreenshotFilename(s.filename) }))
      .filter(s => s.parsed !== null);

    const typeMatched = parsed.filter(s => {
      const normalizedShotType = normalizeTypeForMatch(s.parsed.type);
      const match = normalizedShotType === normalizedIncType;
      if (match) console.log('DEBUG findMatchingShots: Type match found:', s.filename);
      return match;
    });

    if (!typeMatched.length) {
      console.log('DEBUG findMatchingShots: No type matches for', normalizedIncType);
      return [];
    }

    // Try time window ±5 minutes
    if (vTime) {
      const TIME_WINDOW_MS = 5 * 60 * 1000;
      const timeMatched = typeMatched.filter(s =>
        Math.abs(s.parsed.ts - vTime) <= TIME_WINDOW_MS
      );
      if (timeMatched.length > 0) {
        console.log('DEBUG findMatchingShots: Time-matched', timeMatched.length, 'screenshots');
        return timeMatched.sort((a, b) => a.parsed.ts - b.parsed.ts);
      }
      // Fallback: closest by timestamp
      const withDistance = typeMatched
        .map(s => ({ ...s, dist: Math.abs(s.parsed.ts - vTime) }))
        .sort((a, b) => a.dist - b.dist);
      console.log('DEBUG findMatchingShots: Fallback - closest', withDistance.slice(0,3).map(s=>s.filename));
      return withDistance.slice(0, 3).map(({ dist, ...s }) => s);
    }

    // No timestamp — return 3 most recent
    return typeMatched.sort((a, b) => b.parsed.ts - a.parsed.ts).slice(0, 3);
  }, [screenshots, parseScreenshotFilename, normalizeTypeForMatch]);

  // ── Resolve user ID ───────────────────────────────────────────────────
  useEffect(()=>{
    if(!token){ setError('No auth token.'); setLoading(false); return; }
    const resolve=async()=>{
      const direct=user?.id??user?.userId??user?.user_id;
      if(direct){ setResolvedId(direct); return; }
      const dec=decodeJWT(token);
      const jid=dec?.id??dec?.userId??dec?.user_id??dec?.sub;
      if(jid&&!isNaN(Number(jid))){ setResolvedId(Number(jid)); return; }
      try{ const r=await fetch(`${API_BASE}/auth/me`,{headers:authH()}); if(r.ok){const d=await r.json();const id=d?.id??d?.data?.id;if(id){setResolvedId(id);return;}} }catch{}
      const em=user?.email??dec?.email;
      if(em){ try{ const r=await fetch(`${API_BASE}/users`,{headers:authH()}); if(r.ok){const d=await r.json();const list=Array.isArray(d)?d:(d.data??[]);const f=list.find(u=>u.email===em);if(f?.id){setResolvedId(f.id);return;}} }catch{} }
      setError('Could not verify session.'); setLoading(false);
    };
    resolve();
  },[token]);

  const fetchData=useCallback(async()=>{
    if(!resolvedId) return;
    setLoading(true); setError(null); setNoProfile(false);
    try{
      const dr=await fetch(`${API_BASE}/drivers/user/${resolvedId}`,{headers:authH()});
      if(!dr.ok){
        if(dr.status===404){setNoProfile(true);setLoading(false);return;}
        setError(dr.status===401||dr.status===403?'Session expired.':`Error (${dr.status}).`);
        setLoading(false); return;
      }
      const dpRaw=await dr.json(); const dp=dpRaw?.data??dpRaw; setDriverInfo(dp);
      try{ const r=await fetch(`${API_BASE}/users/${resolvedId}`,{headers:authH()}); if(r.ok){const d=await r.json();setFullUserInfo(d?.data??d);} }catch{}
      const did=dp?.id??dp?.driverId??dp?.driver_id;
      if(!did){setError('Profile incomplete.');setLoading(false);return;}
      const[incR,trR,vhR]=await Promise.all([
        fetch(`${API_BASE}/incidents/driver/${did}`,{headers:authH()}),
        fetch(`${API_BASE}/trips/driver/${did}`,    {headers:authH()}),
        fetch(`${API_BASE}/vehicles`,               {headers:authH()}),
      ]);
      if(vhR.ok){const vd=await vhR.json();const vl=Array.isArray(vd)?vd:(Array.isArray(vd?.data)?vd.data:[]);const vm={};vl.forEach(v=>{const id=v.vehicleId??v.vehicle_id??v.id;if(id!=null)vm[String(id)]=v;});setVehicles(vm);}else setVehicles({});
      if(incR.ok){const d=await incR.json();setIncidents(Array.isArray(d)?d:(Array.isArray(d?.data)?d.data:[]));}else setIncidents([]);
      if(trR.ok){
        const d=await trR.json();const list=Array.isArray(d)?d:(Array.isArray(d?.data)?d.data:[]);
        if(list.length===0){
          try{const r=await fetch(`${API_BASE}/trips`,{headers:authH()});if(r.ok){const ad=await r.json();const al=Array.isArray(ad)?ad:(Array.isArray(ad?.data)?ad.data:[]);setTrips(al.filter(t=>{const ids=[t.driver?.id,t.driver?.driverId,t.driverId,t.driver_id].filter(v=>v!=null);return ids.some(id=>String(id)===String(did));}));}}catch{setTrips([]);}
        }else setTrips(list);
      }else setTrips([]);
    }catch{setError('Network error. Check connection.');}finally{setLoading(false);}
  },[resolvedId,authH]);

  useEffect(()=>{fetchData();},[fetchData]);

  const logout=()=>{
    localStorage.removeItem('dg_token');
    localStorage.removeItem('dg_user');
    window.location.href='/login';
  };

  const gT  = (i) => resolveIncidentType(i);
  const gTm = (i) => i?.timestamp??i?.detectedAt??i?.createdAt??null;

  const totalV    = incidents.length;
  const phoneV    = incidents.filter(i=>gT(i).includes('PHONE')).length;
  const drowsyV   = incidents.filter(i=>gT(i).includes('DROWS') || gT(i).includes('DROWSY')).length;
  const completedT= trips.filter(t=>{const s=String(t.status??'').toUpperCase();return s==='COMPLETED'||s==='1';}).length;
  const score     = driverInfo?.safetyScore??Math.max(0,100
    -incidents.filter(i=>gT(i).includes('PHONE')).length*10
    -incidents.filter(i=>gT(i).includes('DROWS')).length*8
    -incidents.filter(i=>gT(i).includes('SEATBELT')).length*5
    -incidents.filter(i=>gT(i).includes('DISTRACT')).length*3
  );
  const recent=[...incidents].sort((a,b)=>new Date(gTm(b)||0)-new Date(gTm(a)||0)).slice(0,5);
  const displayUser=fullUserInfo??user;
  const fullName=displayUser?`${displayUser.firstName||displayUser.first_name||''} ${displayUser.lastName||displayUser.last_name||''}`.trim()||displayUser.email:'Driver';
  const ini=(displayUser?.firstName||displayUser?.first_name||displayUser?.email||'D')[0].toUpperCase();

  if(loading) return(
    <div style={{height:'100vh',display:'flex',alignItems:'center',justifyContent:'center',background:'#f0fdf4',fontFamily:"'Plus Jakarta Sans',sans-serif"}}>
      <style>{GLOBAL_STYLES}</style>
      <div style={{textAlign:'center'}}>
        <div style={{width:48,height:48,border:'4px solid #bbf7d0',borderTopColor:'#16a34a',borderRadius:'50%',animation:'spin .8s linear infinite',margin:'0 auto 16px'}}/>
        <div style={{color:'#15803d',fontSize:14,fontWeight:600}}>Loading your dashboard…</div>
      </div>
    </div>
  );

  if(noProfile) return <PendingSetupScreen displayUser={displayUser??user} fullName={fullName} onRetry={fetchData} onLogout={logout}/>;

  const NAV=[
    {key:'dashboard', Icon:Icons.Dashboard, label:'Dashboard'},
    {key:'violations',Icon:Icons.Violations,label:'My Violations'},
    {key:'trips',     Icon:Icons.Trips,     label:'My Trips'},
    {key:'profile',   Icon:Icons.Profile,   label:'My Profile'},
  ];
  const TH={padding:'11px 16px',textAlign:'left',fontSize:10.5,fontWeight:700,color:'#9ca3af',textTransform:'uppercase',letterSpacing:'0.07em',borderBottom:'1px solid #f1f5f9',background:'#fafafa'};
  const TD={padding:'13px 16px',borderBottom:'1px solid #f8fafc',verticalAlign:'middle'};

  const ErrBanner=({msg})=>msg?<div style={{background:'#fef2f2',border:'1px solid #fecaca',borderRadius:12,padding:'13px 18px',marginBottom:18,color:'#dc2626',fontSize:13,display:'flex',alignItems:'center',gap:10}}><Icons.Warning/>{msg}</div>:null;

  // ── DASHBOARD ─────────────────────────────────────────────────────────
  const TabDashboard=()=>(
    <div className="dg-main">
      <ErrBanner msg={error}/>
      <div style={{background:'linear-gradient(130deg,#15803d 0%,#16a34a 45%,#22c55e 100%)',borderRadius:18,padding:'30px 32px',marginBottom:20,position:'relative',overflow:'hidden',boxShadow:'0 10px 36px rgba(21,128,61,.32)',flexShrink:0}}>
        <div style={{position:'absolute',top:-50,right:-50,width:200,height:200,borderRadius:'50%',background:'rgba(255,255,255,.07)'}}/>
        <div style={{position:'absolute',bottom:-40,right:160,width:130,height:130,borderRadius:'50%',background:'rgba(255,255,255,.05)'}}/>
        <div style={{position:'absolute',top:0,right:0,bottom:0,width:180,display:'flex',flexDirection:'column',alignItems:'center',justifyContent:'center',borderLeft:'1px solid rgba(255,255,255,.1)'}}>
          <div style={{fontSize:50,fontWeight:900,color:'#fff',lineHeight:1,textShadow:'0 2px 16px rgba(0,0,0,.2)'}}>{score}</div>
          <div style={{fontSize:11,color:'rgba(255,255,255,.65)',fontWeight:700,letterSpacing:'0.08em',textTransform:'uppercase',marginTop:4}}>Safety Score</div>
          <div style={{marginTop:8,fontSize:11,color:'rgba(255,255,255,.55)',fontWeight:500}}>{score>=80?'🟢 Excellent':score>=60?'🟡 Fair':'🔴 Needs Work'}</div>
        </div>
        <div style={{paddingRight:200}}>
          <div style={{fontSize:11,fontWeight:700,color:'rgba(255,255,255,.65)',textTransform:'uppercase',letterSpacing:'0.1em',marginBottom:6}}>Welcome back</div>
          <div style={{fontSize:26,fontWeight:900,color:'#fff',letterSpacing:'-0.6px',lineHeight:1.1}}>{fullName}</div>
          <div style={{fontSize:13,color:'rgba(255,255,255,.7)',marginTop:8}}>{driverInfo?.licenseNumber?`License: ${driverInfo.licenseNumber}`:'Driver Account'} · DriveGuard AI Monitoring</div>
        </div>
      </div>

      <div style={{display:'flex',gap:14,marginBottom:20,flexWrap:'wrap',flexShrink:0}}>
        <StatCard label="Total Violations" value={totalV}     sub="All time"       color="#ef4444" accent="#ef4444" Ic={Icons.Warning}/>
        <StatCard label="Phone Violations" value={phoneV}     sub="Phone use"      color="#f59e0b" accent="#f59e0b" Ic={Icons.Phone}/>
        <StatCard label="Drowsy Events"    value={drowsyV}    sub="Drowsiness"     color="#a78bfa" accent="#a78bfa" Ic={Icons.Sleep}/>
        <StatCard label="Trips Completed"  value={completedT} sub="Finished trips" color="#16a34a" accent="#16a34a" Ic={Icons.Car}/>
      </div>

      <div style={{display:'flex',gap:16,flexWrap:'wrap',flex:1,minHeight:0,alignItems:'stretch'}}>
        <div style={{background:'#fff',borderRadius:16,padding:'22px',flex:'0 0 210px',border:'1px solid #f1f5f9',boxShadow:'0 2px 12px rgba(0,0,0,.04)',textAlign:'center',display:'flex',flexDirection:'column',justifyContent:'center'}}>
          <div style={{fontSize:13,fontWeight:700,color:'#374151',marginBottom:14}}>Safety Score</div>
          <ScoreRing score={score}/>
          <div style={{marginTop:12,fontSize:12,color:'#6b7280',fontWeight:500}}>
            {score>=80?'🟢 Great — keep it up!':score>=60?'🟡 Needs improvement':'🔴 High risk — review violations'}
          </div>
        </div>

        <div style={{background:'#fff',borderRadius:16,padding:'22px 24px',flex:1,minWidth:260,border:'1px solid #f1f5f9',boxShadow:'0 2px 12px rgba(0,0,0,.04)',display:'flex',flexDirection:'column',overflow:'hidden'}}>
          <div style={{display:'flex',alignItems:'center',justifyContent:'space-between',marginBottom:16,flexShrink:0}}>
            <div style={{fontSize:14,fontWeight:700,color:'#111827'}}>Recent Violations</div>
            {incidents.length>0&&<span style={{fontSize:11,fontWeight:700,color:'#16a34a',background:'#f0fdf4',padding:'3px 10px',borderRadius:20}}>{incidents.length} total</span>}
          </div>
          <div style={{flex:1,overflowY:'auto',minHeight:0}}>
            {recent.length===0
              ?<div style={{color:'#9ca3af',fontSize:13,padding:'24px 0',textAlign:'center'}}>✅ No violations recorded</div>
              :recent.map((inc,i)=>{
                const resolvedType = gT(inc);
                const m=getVM(resolvedType);
                const t=gTm(inc);
                const shots=findMatchingShots(inc);
                return(
                  <div key={inc.incident_id??inc.id??i} style={{display:'flex',alignItems:'center',gap:12,padding:'12px 0',borderBottom:i<recent.length-1?'1px solid #f8fafc':'none'}}>
                    <div style={{width:38,height:38,borderRadius:10,background:m.bg,display:'flex',alignItems:'center',justifyContent:'center',color:m.color,flexShrink:0}}><m.Icon/></div>
                    <div style={{flex:1}}>
                      <div style={{fontSize:13,fontWeight:600,color:'#111827'}}>{m.label}</div>
                      <div style={{fontSize:11,color:'#9ca3af',marginTop:1}}>{t?new Date(t).toLocaleString():'N/A'}</div>
                    </div>
                    <div style={{display:'flex',alignItems:'center',gap:6,flexShrink:0}}>
                      <span style={{fontSize:11,fontWeight:700,color:m.color,background:m.bg,padding:'3px 10px',borderRadius:20}}>
                        {inc.severity??'Violation'}
                      </span>
                      {shots.length>0&&(
                        <button
                          className="shot-btn"
                          onClick={()=>setModalShot({siblings:shots,index:0,violationType:resolvedType})}
                          title="View screenshot">
                          <Icons.Camera/>
                          View photo
                        </button>
                      )}
                    </div>
                  </div>
                );
              })
            }
          </div>
        </div>
      </div>
    </div>
  );

  // ── VIOLATIONS ────────────────────────────────────────────────────────
  const TabViolations=()=>(
    <div className="dg-main">
      <ErrBanner msg={error}/>
      <div style={{background:'#fff',borderRadius:16,border:'1px solid #f1f5f9',boxShadow:'0 2px 12px rgba(0,0,0,.04)',overflow:'hidden',flex:1,display:'flex',flexDirection:'column',minHeight:0}}>
        <div style={{padding:'20px 24px',borderBottom:'1px solid #f1f5f9',display:'flex',justifyContent:'space-between',alignItems:'center',background:'linear-gradient(135deg,#f0fdf4 0%,#fff 60%)',flexShrink:0}}>
          <div>
            <div style={{fontSize:16,fontWeight:800,color:'#111827'}}>My Violation History</div>
            <div style={{fontSize:12,color:'#9ca3af',marginTop:2}}>{incidents.length} total violations recorded</div>
          </div>
          <div style={{display:'flex',alignItems:'center',gap:10}}>
            {screenshots.length > 0 && (
              <div style={{display:'flex',alignItems:'center',gap:6,background:'#eff6ff',border:'1px solid #bfdbfe',borderRadius:20,padding:'5px 12px'}}>
                <Icons.Camera/>
                <span style={{fontSize:11,fontWeight:700,color:'#1d4ed8'}}>{screenshots.length} screenshots</span>
              </div>
            )}
            <div style={{background:'linear-gradient(135deg,#dc2626,#f87171)',color:'#fff',fontSize:12,fontWeight:700,padding:'6px 16px',borderRadius:20,boxShadow:'0 2px 8px rgba(220,38,38,.3)'}}>Score: {score}/100</div>
          </div>
        </div>
        {incidents.length===0
          ?<div style={{textAlign:'center',padding:'48px',color:'#9ca3af',fontSize:14}}>✅ No violations — excellent driving!</div>
          :<div style={{overflowY:'auto',flex:1,minHeight:0}}>
            <table style={{width:'100%',borderCollapse:'collapse',fontSize:13.5}}>
              <thead>
                <tr>
                  {['#','Type','Severity','Date & Time','Description','Screenshot'].map(h=>(
                    <th key={h} style={TH}>{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {incidents.map((inc,i)=>{
                  const resolvedType = gT(inc);
                  const m=getVM(resolvedType);
                  const t=gTm(inc);
                  const shots=findMatchingShots(inc);
                  return(
                    <tr key={inc.incident_id??inc.id??i} className="dg-row">
                      <td style={TD}><span style={{fontSize:12,color:'#9ca3af',fontWeight:600}}>#{i+1}</span></td>
                      <td style={TD}>
                        <div style={{display:'flex',alignItems:'center',gap:9}}>
                          <div style={{width:30,height:30,borderRadius:8,background:m.bg,display:'flex',alignItems:'center',justifyContent:'center',color:m.color}}><m.Icon/></div>
                          <span style={{fontSize:13,fontWeight:600,color:'#111827'}}>{m.label}</span>
                        </div>
                      </td>
                      <td style={TD}>
                        <span style={{fontSize:11,fontWeight:700,color:m.color,background:m.bg,padding:'3px 10px',borderRadius:20}}>
                          {inc.severity??'Medium'}
                        </span>
                      </td>
                      <td style={TD}><div style={{fontSize:12,color:'#374151'}}>{t?new Date(t).toLocaleString():'N/A'}</div></td>
                      <td style={TD}><div style={{fontSize:12,color:'#6b7280',maxWidth:220}}>{inc.description??'—'}</div></td>
                      <td style={TD}>
                        {shots.length === 0
                          ? <span style={{fontSize:11,color:'#d1d5db',fontStyle:'italic'}}>No photo</span>
                          : (
                            <button
                              className="shot-btn"
                              onClick={()=>{
                                console.log('DEBUG: Opening modal for', resolvedType, 'shots:', shots);
                                setModalShot({siblings:shots,index:0,violationType:resolvedType});
                              }}>
                              <Icons.Camera/>
                              {shots.length > 1 ? `${shots.length} photos` : 'View photo'}
                            </button>
                          )
                        }
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        }
      </div>
    </div>
  );

  // ── TRIPS ─────────────────────────────────────────────────────────────
  const TabTrips=()=>(
    <div className="dg-main">
      <ErrBanner msg={error}/>
      <div style={{background:'#fff',borderRadius:16,border:'1px solid #f1f5f9',boxShadow:'0 2px 12px rgba(0,0,0,.04)',overflow:'hidden',flex:1,display:'flex',flexDirection:'column',minHeight:0}}>
        <div style={{padding:'20px 24px',borderBottom:'1px solid #f1f5f9',display:'flex',justifyContent:'space-between',alignItems:'center',background:'linear-gradient(135deg,#f0fdf4 0%,#fff 60%)',flexShrink:0}}>
          <div>
            <div style={{fontSize:16,fontWeight:800,color:'#111827'}}>My Trip History</div>
            <div style={{fontSize:12,color:'#9ca3af',marginTop:2}}>{trips.length} total trips · {completedT} completed</div>
          </div>
          <div style={{background:'linear-gradient(135deg,#15803d,#22c55e)',color:'#fff',fontSize:12,fontWeight:700,padding:'6px 16px',borderRadius:20,boxShadow:'0 2px 8px rgba(21,128,61,.28)'}}>{completedT} Completed</div>
        </div>
        {trips.length===0
          ?<div style={{textAlign:'center',padding:'48px',color:'#9ca3af',fontSize:14}}>No trips recorded yet.</div>
          :<div style={{overflowY:'auto',flex:1,minHeight:0}}>
            <table style={{width:'100%',borderCollapse:'collapse',fontSize:13.5}}>
              <thead><tr>{['Trip Name','Start Time','End Time','Status','Vehicle'].map(h=><th key={h} style={TH}>{h}</th>)}</tr></thead>
              <tbody>{[...trips].sort((a,b)=>new Date(a.startTime||0)<new Date(b.startTime||0)?1:-1).map((trip,i)=>{
                const st=getTripSt(trip.status);const key=trip.tripId??trip.id??i;
                const rv=trip.vehicle?.vehicleId??trip.vehicle?.id??trip.vehicleId??trip.vehicle_id;
                const vobj=rv!=null?vehicles[String(rv)]:null;
                return(
                  <tr key={key} className="dg-row">
                    <td style={TD}><div style={{display:'flex',alignItems:'center',gap:9}}><div style={{width:30,height:30,borderRadius:8,background:'rgba(22,163,74,.1)',display:'flex',alignItems:'center',justifyContent:'center',color:'#16a34a'}}><Icons.Car/></div><span style={{fontSize:13,fontWeight:600,color:'#111827'}}>{trip.tripName??trip.trip_name??`Trip #${trip.tripId??i+1}`}</span></div></td>
                    <td style={TD}><div style={{fontSize:12,color:'#374151',display:'flex',alignItems:'center',gap:5}}><span style={{color:'#9ca3af'}}><Icons.Clock/></span>{trip.startTime?new Date(trip.startTime).toLocaleString():'N/A'}</div></td>
                    <td style={TD}><div style={{fontSize:12,color:'#374151'}}>{trip.endTime?new Date(trip.endTime).toLocaleString():'—'}</div></td>
                    <td style={TD}><span style={{fontSize:11,fontWeight:700,color:st.color,background:st.bg,padding:'3px 10px',borderRadius:20}}>{st.label}</span></td>
                    <td style={TD}><div style={{display:'flex',alignItems:'center',gap:7}}><div style={{width:26,height:26,borderRadius:7,background:'rgba(22,163,74,.1)',display:'flex',alignItems:'center',justifyContent:'center',color:'#16a34a',flexShrink:0}}><Icons.Car/></div><div><div style={{fontSize:13,fontWeight:600,color:'#111827'}}>{vobj?.model??(rv?`Vehicle #${rv}`:'—')}</div>{vobj&&<div style={{fontSize:11,color:'#6b7280',marginTop:1}}>{vobj.plateNumber??vobj.plate_number??''}</div>}</div></div></td>
                  </tr>
                );})}</tbody>
            </table>
          </div>
        }
      </div>
    </div>
  );

  // ── PROFILE ───────────────────────────────────────────────────────────
  const TabProfile=()=>{
    const fields=[
      {label:'First Name',   value:displayUser?.firstName  ||displayUser?.first_name  ||'—'},
      {label:'Last Name',    value:displayUser?.lastName   ||displayUser?.last_name   ||'—'},
      {label:'Email',        value:displayUser?.email      ||'—'},
      {label:'Phone',        value:displayUser?.phoneNumber||displayUser?.phone_number||displayUser?.phone||'—'},
      {label:'Role',         value:'Driver'},
      {label:'License No.',  value:driverInfo?.licenseNumber||driverInfo?.license_number||'—'},
      {label:'Driver Status',value:driverInfo?.status??'—'},
      {label:'Hire Date',    value:driverInfo?.hireDate?new Date(driverInfo.hireDate).toLocaleDateString():'—'},
    ];
    return(
      <div className="dg-main" style={{maxWidth:620}}>
        <ErrBanner msg={error}/>
        <div style={{background:'linear-gradient(130deg,#15803d,#22c55e)',borderRadius:18,padding:'28px 30px',marginBottom:16,display:'flex',alignItems:'center',gap:20,boxShadow:'0 8px 28px rgba(21,128,61,.25)',position:'relative',overflow:'hidden',flexShrink:0}}>
          <div style={{position:'absolute',top:-30,right:-30,width:120,height:120,borderRadius:'50%',background:'rgba(255,255,255,.08)'}}/>
          <div style={{width:68,height:68,borderRadius:'50%',background:'rgba(255,255,255,.2)',backdropFilter:'blur(8px)',border:'2px solid rgba(255,255,255,.4)',display:'flex',alignItems:'center',justifyContent:'center',color:'#fff',fontSize:24,fontWeight:800,flexShrink:0}}>{ini}</div>
          <div>
            <div style={{fontSize:20,fontWeight:800,color:'#fff'}}>{fullName}</div>
            <div style={{fontSize:13,color:'rgba(255,255,255,.75)',marginTop:2}}>{displayUser?.email}</div>
            <span style={{fontSize:11,fontWeight:700,color:'#15803d',background:'#dcfce7',padding:'3px 10px',borderRadius:20,marginTop:8,display:'inline-block'}}>DRIVER</span>
          </div>
        </div>
        <div style={{background:'#fff',borderRadius:16,border:'1px solid #f1f5f9',boxShadow:'0 2px 12px rgba(0,0,0,.04)',padding:'22px 24px',marginBottom:16,flexShrink:0}}>
          <div style={{fontSize:14,fontWeight:700,color:'#111827',marginBottom:16}}>Account Details</div>
          <div style={{display:'grid',gridTemplateColumns:'1fr 1fr',gap:12}}>
            {fields.map(f=>(
              <div key={f.label} style={{background:'#f8fafc',borderRadius:10,padding:'12px 14px',border:'1px solid #f1f5f9'}}>
                <div style={{fontSize:10.5,color:'#9ca3af',fontWeight:700,textTransform:'uppercase',letterSpacing:'0.06em'}}>{f.label}</div>
                <div style={{fontSize:14,fontWeight:600,color:'#111827',marginTop:4}}>{f.value}</div>
              </div>
            ))}
          </div>
        </div>
        <div style={{background:'#fff',borderRadius:16,border:'1px solid #f1f5f9',boxShadow:'0 2px 12px rgba(0,0,0,.04)',padding:'22px 24px',display:'flex',alignItems:'center',gap:24,flexWrap:'wrap',flex:1,minHeight:0}}>
          <ScoreRing score={score}/>
          <div style={{flex:1,minWidth:160}}>
            <div style={{fontSize:14,fontWeight:700,color:'#111827',marginBottom:12}}>Safety Summary</div>
            {[{label:'Total Violations',value:totalV,color:'#ef4444'},{label:'Completed Trips',value:completedT,color:'#16a34a'},{label:'Safety Score',value:`${score}/100`,color:score>=80?'#16a34a':score>=60?'#fbbf24':'#ef4444'}].map(r=>(
              <div key={r.label} style={{display:'flex',justifyContent:'space-between',padding:'8px 0',borderBottom:'1px solid #f8fafc',fontSize:13}}>
                <span style={{color:'#374151'}}>{r.label}</span>
                <span style={{fontWeight:700,color:r.color}}>{r.value}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    );
  };

  const tabTitles={dashboard:'Dashboard',violations:'My Violations',trips:'My Trips',profile:'My Profile'};

  return(
    <div style={{display:'flex',height:'100vh',background:'#f0f4f8',fontFamily:"'Plus Jakarta Sans',sans-serif"}}>
      <style>{GLOBAL_STYLES}</style>

      {/* Screenshot Modal */}
      <ScreenshotModal
        modalShot={modalShot}
        setModalShot={setModalShot}
        parseScreenshotFilename={parseScreenshotFilename}
      />

      {/* SIDEBAR */}
      <div style={{
        width:sideCollapsed?68:232,minWidth:sideCollapsed?68:232,
        background:'linear-gradient(180deg,#16a34a 0%,#15803d 50%,#14532d 100%)',
        display:'flex',flexDirection:'column',
        transition:'width .22s cubic-bezier(.4,0,.2,1)',overflow:'hidden',
        boxShadow:'4px 0 28px rgba(0,0,0,.14)',position:'relative',zIndex:10,
      }}>
        <div style={{position:'absolute',top:-70,right:-70,width:200,height:200,borderRadius:'50%',background:'rgba(255,255,255,.05)',pointerEvents:'none'}}/>
        <div style={{position:'absolute',bottom:100,left:-50,width:140,height:140,borderRadius:'50%',background:'rgba(255,255,255,.04)',pointerEvents:'none'}}/>

        <div style={{padding:sideCollapsed?'20px 0':'20px 18px',display:'flex',alignItems:'center',gap:10,borderBottom:'1px solid rgba(255,255,255,.12)',justifyContent:sideCollapsed?'center':'flex-start',flexShrink:0}}>
          <div style={{width:36,height:36,borderRadius:10,background:'rgba(255,255,255,.18)',backdropFilter:'blur(8px)',border:'1px solid rgba(255,255,255,.3)',display:'flex',alignItems:'center',justifyContent:'center',color:'#fff',flexShrink:0}}>
            <Icons.ShieldLg/>
          </div>
          {!sideCollapsed&&<div>
            <div style={{fontSize:14,fontWeight:900,color:'#fff',letterSpacing:'-0.3px',lineHeight:1.1}}>DriveGuard</div>
            <div style={{fontSize:9.5,fontWeight:700,color:'rgba(255,255,255,.5)',letterSpacing:'0.12em',textTransform:'uppercase'}}>AI Platform</div>
          </div>}
        </div>

        <nav style={{flex:1,padding:'14px 10px',overflowY:'auto'}}>
          {!sideCollapsed&&<div style={{fontSize:9,fontWeight:700,color:'rgba(255,255,255,.3)',letterSpacing:'0.14em',textTransform:'uppercase',padding:'4px 8px 10px'}}>Main Menu</div>}
          {NAV.map(item=>(
            <button key={item.key} onClick={()=>setTab(item.key)}
              className="dg-nav"
              title={sideCollapsed?item.label:undefined}
              style={{display:'flex',alignItems:'center',gap:10,width:'100%',padding:sideCollapsed?'11px 0':'10px 12px',justifyContent:sideCollapsed?'center':'flex-start',borderRadius:10,border:'none',cursor:'pointer',marginBottom:3,background:tab===item.key?'rgba(255,255,255,.2)':'transparent',color:'#fff',fontWeight:tab===item.key?700:500,fontSize:14,fontFamily:"'Plus Jakarta Sans',sans-serif",textAlign:'left',whiteSpace:'nowrap',position:'relative',transition:'background .15s ease'}}>
              {tab===item.key&&!sideCollapsed&&<span style={{position:'absolute',left:0,top:'18%',bottom:'18%',width:3,borderRadius:'0 3px 3px 0',background:'#86efac'}}/>}
              <span style={{opacity:tab===item.key?1:.65,display:'flex',alignItems:'center',marginLeft:tab===item.key&&!sideCollapsed?4:0}}><item.Icon/></span>
              {!sideCollapsed&&item.label}
            </button>
          ))}
        </nav>

        <div style={{padding:'8px 10px',borderTop:'1px solid rgba(255,255,255,.1)',flexShrink:0}}>
          <button onClick={()=>setSideCollapsed(c=>!c)} style={{width:'100%',padding:'9px 0',borderRadius:8,border:'1px solid rgba(255,255,255,.15)',background:'rgba(255,255,255,.07)',color:'rgba(255,255,255,.65)',cursor:'pointer',fontSize:12,fontFamily:"'Plus Jakarta Sans',sans-serif",display:'flex',alignItems:'center',justifyContent:'center',gap:6}}>
            {sideCollapsed?'→':'← Collapse'}
          </button>
        </div>

        <div style={{padding:'8px 10px 20px',flexShrink:0}}>
          <button onClick={logout} style={{display:'flex',alignItems:'center',gap:10,width:'100%',padding:sideCollapsed?'10px 0':'11px 12px',justifyContent:sideCollapsed?'center':'flex-start',borderRadius:10,border:'none',background:'rgba(239,68,68,.15)',color:'#fca5a5',cursor:'pointer',fontSize:13.5,fontFamily:"'Plus Jakarta Sans',sans-serif",fontWeight:600}}>
            <Icons.LogOut/>
            {!sideCollapsed&&'Log Out'}
          </button>
        </div>
      </div>

      {/* MAIN CONTENT */}
      <div style={{flex:1,overflow:'hidden',display:'flex',flexDirection:'column'}}>
        <div style={{background:'#fff',borderBottom:'1px solid #e5e7eb',padding:'0 32px',height:66,display:'flex',alignItems:'center',justifyContent:'space-between',flexShrink:0,boxShadow:'0 1px 10px rgba(0,0,0,.05)'}}>
          <div>
            <div style={{fontSize:20,fontWeight:900,color:'#0f172a',letterSpacing:'-0.5px'}}>{tabTitles[tab]}</div>
            <div style={{fontSize:11.5,color:'#94a3b8',marginTop:1}}>{new Date().toLocaleDateString('en-US',{weekday:'long',year:'numeric',month:'long',day:'numeric'})}</div>
          </div>
          <div style={{display:'flex',alignItems:'center',gap:12}}>
            <div style={{textAlign:'right'}}>
              <div style={{fontSize:13,fontWeight:700,color:'#0f172a'}}>{fullName}</div>
              <div style={{fontSize:11,color:'#94a3b8'}}>Driver</div>
            </div>
            <div style={{width:40,height:40,borderRadius:'50%',background:'linear-gradient(135deg,#15803d,#22c55e)',display:'flex',alignItems:'center',justifyContent:'center',color:'#fff',fontSize:15,fontWeight:800,boxShadow:'0 2px 10px rgba(21,128,61,.3)'}}>{ini}</div>
          </div>
        </div>

        <div style={{flex:1,padding:'28px 32px',overflowY:'auto',display:'flex',flexDirection:'column',minHeight:0}}>
          {tab==='dashboard'  && <TabDashboard/>}
          {tab==='violations' && <TabViolations/>}
          {tab==='trips'      && <TabTrips/>}
          {tab==='profile'    && <TabProfile/>}
        </div>
      </div>
    </div>
  );
}
